digraph CLAIMLENS {
 graph [fontname="DejaVu Sans",rankdir=LR, bgcolor="#FFFFFF",pad="0.4",nodesep="0.35",ranksep="0.85",splines=polyline, label="CLAIMLENS  |  Logical Entity Relationships", labelloc=t,fontsize=23,fontcolor="#173047"];
 node [shape=record, fontname="DejaVu Sans",fontsize=10, style="filled,rounded",fillcolor="#F3F8FB", color="#AAC0CE",penwidth=1.1];
 edge [color="#6F8796", penwidth=1.1, arrowsize=0.65, fontsize=9,fontcolor="#354A59"];
 users [label="{APP_USERS|PK id • email unique\lrole • password_hash\l}",fillcolor="#E4F3FF"];
 maker [label="{MANUFACTURERS|PK id • name\l}"];
 models [label="{PRODUCT_MODELS|PK id • model_name\lFK manufacturer_id\l}"];
 registered [label="{REGISTERED_PRODUCTS|PK id • serial_number\lFK customer_id • model_id\l}",fillcolor="#E4F3FF"];
 policies [label="{WARRANTY_POLICIES|PK id • version\lFK manufacturer_id\l}",fillcolor="#E9F7E0"];
 rules [label="{POLICY_RULES|PK id • kind\lFK policy_id\l}",fillcolor="#E9F7E0"];
 warranties [label="{WARRANTIES|PK id • start/end\lFK product_id • policy_id\l}"];
 claims [label="{WARRANTY_CLAIMS|PK id • status\lFK warranty_id • customer_id\l}",fillcolor="#FFF1DB"];
 evid [label="{CLAIM_EVIDENCE|PK id • URL\lFK claim_id\l}"];
 assignments [label="{CLAIM_ASSIGNMENTS|PK/FK claim_id\lFK officer_id\l}"];
 decisions [label="{CLAIM_DECISIONS|PK id • verdict\lFK claim_id • officer_id\l}"];
 repairs [label="{REPAIR_ORDERS|PK id • status\lFK claim_id\l}"];
 audits [label="{AUDIT_EVENTS|PK id • JSONB details\lFK actor_id\l}"];
 documents [label="{POLICY_DOCUMENTS|PK id • sha256\lFK policy_id • uploaded_by\l}",fillcolor="#F0EAFF"];
 chunks [label="{DOCUMENT_CHUNKS|PK id • vector(384)\lFK document_id • JSONB metadata\l}",fillcolor="#F0EAFF"];
 matches [label="{SEMANTIC_MATCHES|PK id • rank • score\lFK claim_id • chunk_id\l}",fillcolor="#F0EAFF"];
 users->registered [label="customer 1:N"];
 maker->models [label="1:N"];
 models->registered [label="1:N"];
 maker->policies [label="1:N"];
 policies->rules [label="1:N"];
 registered->warranties [label="1:0..1"];
 policies->warranties [label="1:N"];
 warranties->claims [label="1:N"];
 users->claims [label="customer 1:N"];
 claims->evid [label="1:N"];
 claims->assignments [label="1:0..1"];
 users->assignments [label="officer 1:N"];
 claims->decisions [label="1:0..1"];
 claims->repairs [label="1:0..1"];
 claims->matches [label="1:N"];
 policies->documents [label="1:N"];
 documents->chunks [label="1:N"];
 chunks->matches [label="1:N"];
 users->audits [label="actor 1:N",style=dashed];
}
